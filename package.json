{
  "name": "plataforma-analises-aprendizagem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "desenvolver": "node ./node_modules/next/dist/bin/next dev",
    "compilar": "npm run banco:gerar && node ./node_modules/next/dist/bin/next build",
    "iniciar": "node ./node_modules/next/dist/bin/next start",
    "verificar-estilo": "node ./node_modules/eslint/bin/eslint.js .",
    "verificar-tipos": "node ./node_modules/typescript/bin/tsc --noEmit",
    "verificar:segredos": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-segredos-versionados.ts",
    "testar": "node ./node_modules/vitest/vitest.mjs run",
    "testar:observando": "node ./node_modules/vitest/vitest.mjs",
    "testar:integracao": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-autorizacao-apis.ts",
    "testar:servicos": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-servicos-modulos.ts",
    "testar:sessoes": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-servicos-sessoes.ts",
    "testar:crud-sessoes": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-crud-sessoes.ts",
    "testar:api-sessoes": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-api-sessoes.ts",
    "testar:modelo-sessoes": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-modelo-sessoes.ts",
    "testar:metricas": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-metricas-sinteticas.ts",
    "testar:metricas-sessoes": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-metricas-sessoes.ts",
    "testar:configuracoes-ia": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-configuracoes-ia.ts",
    "testar:arquivos": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-arquivos-materiais.ts",
    "testar:materiais-modulo": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-materiais-modulo.ts",
    "testar:desafios": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-desafios-experimentacao.ts",
    "testar:salas": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-servicos-salas.ts",
    "testar:dashboards-salas": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-dashboards-salas.ts",
    "testar:analises-materiais": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-analises-materiais.ts",
    "banco:gerar": "node ./node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "banco:migrar": "node ./node_modules/tsx/dist/cli.mjs scripts/migrar-banco.ts",
    "banco:popular": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "banco:reiniciar": "node ./node_modules/tsx/dist/cli.mjs scripts/reiniciar-banco.ts",
    "banco:verificar-cenario": "node ./node_modules/tsx/dist/cli.mjs scripts/verificar-cenario-sintetico.ts",
    "validar": "npm run verificar:segredos && npm run verificar-estilo && npm run verificar-tipos && npm run testar && npm run compilar"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tesseract.js-data/por": "^1.0.0",
    "better-sqlite3": "^12.11.1",
    "bindings": "^1.5.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.37.0",
    "mammoth": "^1.12.3",
    "next": "^16.3.3",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "read-excel-file": "^5.8.3",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^27.4.0",
    "prisma": "^7.10.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
