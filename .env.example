DATABASE_URL="file:./prisma/dev.db"
# Produção: gere 32 bytes aleatórios em Base64. No desenvolvimento local,
# o aplicativo cria uma chave privada dentro de .dados/, que é ignorada pelo Git.
CHAVE_MESTRA_CREDENCIAIS_IA=""
# As chaves podem ser salvas por conta na interface. Estas variáveis são uma
# alternativa exclusiva do servidor para ambientes que preferem configuração global.
AI_PRIMARY_PROVIDER="GROQ"
GROQ_MODEL="openai/gpt-oss-20b"
GEMINI_MODEL="gemini-3.8-flash"
GROQ_API_KEY=""
GEMINI_API_KEY=""
