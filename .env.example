DATABASE_URL="file:./prisma/dev.db"
# Produção: gere 32 bytes aleatórios em Base64. No desenvolvimento local,
# o aplicativo cria uma chave privada dentro de .dados/, que é ignorada pelo Git.
CHAVE_MESTRA_CREDENCIAIS_IA=""
# Salve a chave global pela interface da conta ADMIN em /configuracoes/ia.
# A aplicação ignora chaves pessoais antigas e não usa GROQ_API_KEY como substituição.
GROQ_MODEL="openai/gpt-oss-20b"
# Opcional: senha de 12 a 128 caracteres somente no primeiro provisionamento.
# Se vazia, banco:configurar-admin e o seed geram uma senha aleatória.
SENHA_ADMIN_INICIAL=""
# Reservada para scripts experimentais executados explicitamente, fora da aplicação.
GROQ_API_KEY=""
