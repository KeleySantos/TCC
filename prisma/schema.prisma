generator cliente {
  provider = "prisma-client"
  output   = "../src/gerado/prisma"
}

datasource banco {
  provider = "sqlite"
}

enum PapelUsuario {
  ALUNO
  PROFESSOR
  ADMINISTRADOR
}

enum FormatoConteudo {
  VIDEO
  PDF
  TEXTO
  IMAGEM
  DOCUMENTO
  PLANILHA
  AUDIO
  MAPA_MENTAL
  PODCAST
  QUIZ
  EXERCICIO_PRATICO
}

enum OrigemMaterial {
  TEXTO
  LINK
  ARQUIVO
}

enum SituacaoAprovacao {
  PENDENTE
  APROVADO
  REJEITADO
}

enum SituacaoSessao {
  PLANEJADA
  ATIVA
  CONCLUIDA
  ABANDONADA
  INVALIDADA
}

enum ModoRegistroSessao {
  MANUAL
  CRONOMETRO
}

enum SituacaoSala {
  ATIVA
  ARQUIVADA
  EXCLUIDA
}

enum PapelMembroSala {
  PROPRIETARIO
  MEMBRO
}

enum SituacaoMembroSala {
  ATIVO
  SAIU
  REMOVIDO
}

enum SituacaoSolicitacaoSala {
  PENDENTE
  APROVADA
  REJEITADA
  CANCELADA
}

enum SituacaoModuloSala {
  ATIVO
  ARQUIVADO
}

enum SituacaoVinculoModuloSala {
  ATIVO
  DESVINCULADO
}

enum EscopoComentarioSala {
  SALA
  MODULO
  MEMBRO
}

model Usuario {
  id               String                  @id @default(cuid())
  nome             String
  nomeUsuario      String                  @unique
  email            String?                 @unique
  senhaHash        String
  // Campo técnico legado. Não representa papel no produto e não deve ser usado em rotas, serviços ou interface.
  papel            PapelUsuario            @default(ALUNO)
  criadoEm         DateTime                @default(now())
  atualizadoEm     DateTime                @updatedAt
  modulos          ModuloAprendizagem[]
  sessoesEstudo    SessaoEstudo[]          @relation("SessoesDoUsuario")
  desafios         DesafioExperimentacao[]
  perfilAluno      PerfilAluno?
  perfilProfessor  PerfilProfessor?
  eventosAuditoria EventoAuditoria[]       @relation("AtorAuditoria")
  configuracoesIa  ConfiguracaoIa[]
  salasProprias    Sala[]                   @relation("ProprietarioSala")
  membrosSalas     MembroSala[]
  convitesSalas    ConviteSala[]            @relation("CriadorConviteSala")
  solicitacoesSala SolicitacaoEntradaSala[] @relation("SolicitanteSala")
  decisoesSala     SolicitacaoEntradaSala[] @relation("DecisorSolicitacaoSala")
  vinculosSala     VinculoModuloSala[]
  comentariosSala  ComentarioSala[]         @relation("AutorComentarioSala")
  comentariosRecebidosSala ComentarioSala[] @relation("DestinatarioComentarioSala")
}

enum MetodoEstudo {
  FEYNMAN
  RECUPERACAO_ATIVA
  REPETICAO_ESPACADA
  POMODORO
  INTERCALAMENTO
  PRATICA_DISTRIBUIDA
  LEITURA_ATIVA
  VIDEO_GUIADO
  RESUMO
  EXERCICIO
  REVISAO
  OUTRO
}

enum SituacaoDesafioExperimentacao {
  ATIVO
  CANCELADO
}

enum ProvedorIa {
  GROQ
  GEMINI
  QWEN
}

enum EstadoConfiguracaoIa {
  NAO_TESTADA
  FUNCIONANDO
  AUTENTICACAO_INVALIDA
  LIMITADA
  INDISPONIVEL
}

enum SituacaoAnaliseMaterial {
  PENDENTE
  PROCESSANDO
  CONCLUIDA
  FALHA
  NAO_SUPORTADA
}

model ConfiguracaoIa {
  id                   String                @id @default(cuid())
  usuarioId            String
  provedor              ProvedorIa
  chaveCifrada          String
  vetorInicializacao    String
  etiquetaAutenticacao  String
  ativa                 Boolean               @default(true)
  estadoUltimoTeste     EstadoConfiguracaoIa @default(NAO_TESTADA)
  ultimoTesteEm         DateTime?
  bloqueadaAte          DateTime?
  criadoEm              DateTime              @default(now())
  atualizadoEm          DateTime              @updatedAt
  usuario               Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, provedor])
  @@index([usuarioId, ativa])
  @@index([bloqueadaAte])
}

model ModuloAprendizagem {
  id            String                  @id @default(cuid())
  usuarioId     String
  identificador String
  titulo        String
  descricao     String
  arquivado     Boolean                 @default(false)
  rascunho      Boolean                 @default(false)
  criadoEm      DateTime                @default(now())
  atualizadoEm  DateTime                @updatedAt
  usuario       Usuario                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  materiais     RecursoConteudo[]
  sessoesEstudo SessaoEstudo[]          @relation("SessoesDoModulo")
  desafios      DesafioExperimentacao[]
  vinculosSala  VinculoModuloSala[]

  @@unique([usuarioId, identificador])
  @@index([usuarioId, arquivado])
  @@index([usuarioId, arquivado, rascunho])
}

model Sala {
  id             String        @id @default(cuid())
  proprietarioId String
  identificador  String        @unique
  nome           String
  descricao      String
  situacao       SituacaoSala  @default(ATIVA)
  criadaEm       DateTime      @default(now())
  atualizadaEm   DateTime      @updatedAt
  proprietario   Usuario       @relation("ProprietarioSala", fields: [proprietarioId], references: [id], onDelete: Restrict)
  membros        MembroSala[]
  convites       ConviteSala[]
  solicitacoes   SolicitacaoEntradaSala[]
  modulos        ModuloSala[]
  comentarios    ComentarioSala[]

  @@index([proprietarioId, situacao])
}

model MembroSala {
  id          String               @id @default(cuid())
  salaId      String
  usuarioId   String
  papel       PapelMembroSala      @default(MEMBRO)
  situacao    SituacaoMembroSala   @default(ATIVO)
  entrouEm    DateTime             @default(now())
  encerrouEm  DateTime?
  sala        Sala                 @relation(fields: [salaId], references: [id], onDelete: Cascade)
  usuario     Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  vinculos    VinculoModuloSala[]

  @@unique([salaId, usuarioId])
  @@index([usuarioId, situacao])
  @@index([salaId, situacao])
}

model ConviteSala {
  id           String    @id @default(cuid())
  salaId       String
  criadoPorId  String
  codigoHash   String    @unique
  expiraEm     DateTime
  revogadoEm   DateTime?
  criadoEm     DateTime  @default(now())
  sala         Sala      @relation(fields: [salaId], references: [id], onDelete: Cascade)
  criadoPor    Usuario   @relation("CriadorConviteSala", fields: [criadoPorId], references: [id], onDelete: Restrict)
  solicitacoes SolicitacaoEntradaSala[]

  @@index([salaId, revogadoEm, expiraEm])
}

model SolicitacaoEntradaSala {
  id            String                    @id @default(cuid())
  salaId        String
  conviteId     String
  solicitanteId String
  situacao      SituacaoSolicitacaoSala   @default(PENDENTE)
  solicitadaEm  DateTime                  @default(now())
  decididaEm    DateTime?
  decididaPorId String?
  sala          Sala                      @relation(fields: [salaId], references: [id], onDelete: Cascade)
  convite       ConviteSala               @relation(fields: [conviteId], references: [id], onDelete: Restrict)
  solicitante   Usuario                   @relation("SolicitanteSala", fields: [solicitanteId], references: [id], onDelete: Restrict)
  decididaPor   Usuario?                  @relation("DecisorSolicitacaoSala", fields: [decididaPorId], references: [id], onDelete: SetNull)

  @@index([salaId, situacao, solicitadaEm])
  @@index([solicitanteId, situacao])
}

model ModuloSala {
  id          String               @id @default(cuid())
  salaId      String
  titulo      String
  descricao   String
  posicao     Int
  situacao    SituacaoModuloSala   @default(ATIVO)
  criadoEm    DateTime             @default(now())
  atualizadoEm DateTime            @updatedAt
  sala        Sala                 @relation(fields: [salaId], references: [id], onDelete: Cascade)
  vinculos    VinculoModuloSala[]
  comentarios ComentarioSala[]
  evidenciasHistoricas EvidenciaHistoricaModuloSala[]

  @@unique([salaId, posicao])
  @@index([salaId, situacao])
}

model VinculoModuloSala {
  id                    String                     @id @default(cuid())
  moduloSalaId          String
  membroSalaId          String
  usuarioId             String
  moduloPessoalId       String
  situacao              SituacaoVinculoModuloSala @default(ATIVO)
  compartilharDashboard Boolean                    @default(true)
  permitirComparacao    Boolean                    @default(false)
  permitirIa            Boolean                    @default(false)
  vinculadoEm           DateTime                   @default(now())
  dadosDesde             DateTime?
  desvinculadoEm        DateTime?
  moduloSala            ModuloSala                 @relation(fields: [moduloSalaId], references: [id], onDelete: Cascade)
  membroSala            MembroSala                 @relation(fields: [membroSalaId], references: [id], onDelete: Cascade)
  usuario               Usuario                    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  moduloPessoal         ModuloAprendizagem         @relation(fields: [moduloPessoalId], references: [id], onDelete: Restrict)

  @@unique([moduloSalaId, usuarioId])
  @@unique([moduloSalaId, moduloPessoalId])
  @@index([membroSalaId, situacao])
  @@index([usuarioId, situacao])
  @@index([moduloPessoalId, situacao])
}

model EvidenciaHistoricaModuloSala {
  id                       String      @id @default(cuid())
  moduloSalaId             String
  referenciaSessaoHash     String      @unique
  contribuinteAnonimoHash  String
  encerradaEm              DateTime
  duracaoMinutos           Int
  dificuldadePercebida     Int?
  compreensaoPercebida     Int?
  metodosJson              String
  formatosJson             String
  criadaEm                 DateTime    @default(now())
  moduloSala               ModuloSala  @relation(fields: [moduloSalaId], references: [id], onDelete: Cascade)

  @@index([moduloSalaId, encerradaEm])
  @@index([moduloSalaId, contribuinteAnonimoHash])
}

model ComentarioSala {
  id             String                @id @default(cuid())
  salaId         String
  autorId        String
  escopo         EscopoComentarioSala
  moduloSalaId   String?
  destinatarioId String?
  conteudo       String
  criadoEm       DateTime              @default(now())
  sala           Sala                  @relation(fields: [salaId], references: [id], onDelete: Cascade)
  autor          Usuario               @relation("AutorComentarioSala", fields: [autorId], references: [id], onDelete: Restrict)
  moduloSala     ModuloSala?           @relation(fields: [moduloSalaId], references: [id], onDelete: Cascade)
  destinatario   Usuario?              @relation("DestinatarioComentarioSala", fields: [destinatarioId], references: [id], onDelete: Restrict)

  @@index([salaId, criadoEm])
  @@index([moduloSalaId, criadoEm])
  @@index([destinatarioId, criadoEm])
}

model PerfilAluno {
  id            String               @id @default(cuid())
  usuarioId     String               @unique
  pseudonimo    String               @unique
  usuario       Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  matriculas    Matricula[]
  sessoesEstudo SessaoEstudo[]
}

model PerfilProfessor {
  id         String             @id @default(cuid())
  usuarioId  String             @unique
  usuario    Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  turmas     Turma[]
  aprovacoes AprovacaoRecurso[]
}

model Turma {
  id          String          @id @default(cuid())
  nome        String
  periodo     String
  professorId String
  criadaEm    DateTime        @default(now())
  professor   PerfilProfessor @relation(fields: [professorId], references: [id], onDelete: Restrict)
  matriculas  Matricula[]

  @@unique([nome, periodo])
}

model Matricula {
  id       String      @id @default(cuid())
  alunoId  String
  turmaId  String
  criadaEm DateTime    @default(now())
  aluno    PerfilAluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma    Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, turmaId])
  @@index([turmaId])
}

model RecursoConteudo {
  id               String                 @id @default(cuid())
  identificador    String
  titulo           String
  descricao        String
  formato          FormatoConteudo
  minutosEstimados Int
  moduloId         String
  conteudoTexto    String?
  url              String?
  origem           OrigemMaterial         @default(TEXTO)
  ativo            Boolean                @default(true)
  criadoEm         DateTime               @default(now())
  atualizadoEm     DateTime               @updatedAt
  modulo           ModuloAprendizagem     @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  aprovacoes       AprovacaoRecurso[]
  vinculosSessoes  MaterialSessaoEstudo[]
  arquivo          ArquivoMaterial?
  analise          AnaliseMaterial?

  @@unique([moduloId, identificador])
  @@index([moduloId, formato])
  @@index([moduloId, origem, ativo])
}

model AnaliseMaterial {
  id                    String                  @id @default(cuid())
  recursoId             String                  @unique
  situacao              SituacaoAnaliseMaterial @default(PENDENTE)
  versao                String                  @default("analise-material-v1")
  resumo                String?
  conceitosJson         String                  @default("[]")
  pontosRevisaoJson     String                  @default("[]")
  metodosSugeridosJson  String                  @default("[]")
  proximasSessoesJson   String                  @default("[]")
  perguntasReflexaoJson String                  @default("[]")
  origem                String?
  modelo                String?
  caracteresExtraidos   Int                     @default(0)
  conteudoTruncado      Boolean                 @default(false)
  tentativas            Int                     @default(0)
  codigoFalha           String?
  hashConteudo           String?
  analisadaEm           DateTime?
  criadaEm              DateTime                @default(now())
  atualizadaEm          DateTime                @updatedAt
  recurso               RecursoConteudo         @relation(fields: [recursoId], references: [id], onDelete: Cascade)

  @@index([situacao, atualizadaEm])
}

model ArquivoMaterial {
  id                  String          @id @default(cuid())
  recursoId           String          @unique
  nomeOriginal        String
  tipoMime            String
  tamanhoBytes        Int
  chaveArmazenamento  String          @unique
  extensaoNormalizada String
  criadoEm            DateTime        @default(now())
  recurso             RecursoConteudo @relation(fields: [recursoId], references: [id], onDelete: Cascade)

  @@index([recursoId])
}

model AprovacaoRecurso {
  id           String            @id @default(cuid())
  recursoId    String
  professorId  String
  situacao     SituacaoAprovacao @default(PENDENTE)
  observacao   String?
  criadaEm     DateTime          @default(now())
  atualizadaEm DateTime          @updatedAt
  recurso      RecursoConteudo   @relation(fields: [recursoId], references: [id], onDelete: Cascade)
  professor    PerfilProfessor   @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([recursoId, professorId])
  @@index([recursoId, situacao])
}

model SessaoEstudo {
  id                   String                 @id @default(cuid())
  usuarioId            String
  moduloId             String
  // Referência de compatibilidade com o modelo anterior. Novos registros não a preenchem.
  alunoId              String?
  descricao            String                 @default("")
  modoRegistro         ModoRegistroSessao     @default(CRONOMETRO)
  dificuldadePercebida Int?
  compreensaoPercebida Int?
  // Campo legado preservado até a migração completa dos consumidores.
  observacao           String?
  desafioId            String?
  iniciadaEm           DateTime
  encerradaEm          DateTime?
  duracaoMinutos       Int?
  situacao             SituacaoSessao         @default(ATIVA)
  arquivada            Boolean                @default(false)
  criadaEm             DateTime               @default(now())
  atualizadaEm         DateTime               @default(now()) @updatedAt
  usuario              Usuario                @relation("SessoesDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  modulo               ModuloAprendizagem     @relation("SessoesDoModulo", fields: [moduloId], references: [id], onDelete: Cascade)
  aluno                PerfilAluno?           @relation(fields: [alunoId], references: [id], onDelete: SetNull)
  desafio              DesafioExperimentacao? @relation(fields: [desafioId], references: [id], onDelete: SetNull)
  metodos              MetodoSessaoEstudo[]
  formatos             FormatoSessaoEstudo[]
  materiais            MaterialSessaoEstudo[]

  @@index([usuarioId, moduloId, situacao])
  @@index([alunoId, situacao])
  @@index([usuarioId, desafioId, situacao])
  @@index([usuarioId, moduloId, situacao, iniciadaEm])
  @@index([usuarioId, arquivada, situacao])
}

model MetodoSessaoEstudo {
  sessaoId String
  metodo   MetodoEstudo
  sessao   SessaoEstudo @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@id([sessaoId, metodo])
  @@index([metodo])
}

model FormatoSessaoEstudo {
  sessaoId String
  formato  FormatoConteudo
  sessao   SessaoEstudo    @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@id([sessaoId, formato])
  @@index([formato])
}

model MaterialSessaoEstudo {
  sessaoId  String
  recursoId String
  sessao    SessaoEstudo    @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  recurso   RecursoConteudo @relation(fields: [recursoId], references: [id], onDelete: Restrict)

  @@id([sessaoId, recursoId])
  @@index([recursoId])
}

model DesafioExperimentacao {
  id          String                        @id @default(cuid())
  usuarioId   String
  moduloId    String
  metodo      MetodoEstudo
  meta        String
  situacao    SituacaoDesafioExperimentacao @default(ATIVO)
  criadoEm    DateTime                      @default(now())
  canceladoEm DateTime?
  usuario     Usuario                       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  modulo      ModuloAprendizagem            @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  sessoes     SessaoEstudo[]

  @@index([usuarioId, moduloId, situacao])
  @@index([moduloId, metodo, situacao])
}

model EventoAuditoria {
  id        String   @id @default(cuid())
  atorId    String?
  acao      String
  alvo      String
  metadados String?
  criadoEm  DateTime @default(now())
  ator      Usuario? @relation("AtorAuditoria", fields: [atorId], references: [id], onDelete: SetNull)

  @@index([atorId, criadoEm])
}
